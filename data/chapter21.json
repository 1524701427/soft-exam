  "notes": {
    "21.1.1": {
      "page": 5,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "资金在不同时间点的价值不同，等额资金不能不加折现地直接比较。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "现值 P",
              "把未来现金折算到现在时点的等值金额。"
            ],
            [
              "终值 F",
              "现值经过一段时间后的未来等值金额。"
            ],
            [
              "利率 i",
              "反映一个计息周期的资金使用代价。"
            ],
            [
              "期数 n",
              "计算时统一利率和计息周期单位。"
            ]
          ]
        }
      ],
      "tip": "先找 P、F、i、n，再根据资金流方向选择公式。"
    },
    "21.1.2": {
      "page": 6,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "单利只对初始本金计息；复利把每期利息计入下一期本金。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "单利",
              "F=P×(1+n×i)，利息 I=P×n×i。"
            ],
            [
              "复利",
              "F=P×(1+i)^n，利息逐期滚入本金。"
            ],
            [
              "例题",
              "100万元、10%复利、3年，F=133.1万元。"
            ],
            [
              "比较",
              "利率和年限相同时，正利率下复利终值一般更高。"
            ]
          ]
        }
      ],
      "tip": "单利不滚利；复利利滚利。"
    },
    "21.1.3": {
      "page": 9,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "把第 n 年发生的金额折成现在的等值金额，是对未来价值进行折现。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "单期折现",
              "P=F/(1+i)^n。"
            ],
            [
              "终值换算",
              "F=P×(1+i)^n。"
            ],
            [
              "判断",
              "相同利率下，现金流越晚，折现到现在通常越少。"
            ]
          ]
        }
      ],
      "tip": "未来除以折现系数得到现值；现在乘以系数得到终值。"
    },
    "21.1.4": {
      "page": 9,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "净现值将各年的现金流按基准折现率折现，再将流入与流出汇总比较。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "计算",
              "NPV=∑[CF_t/(1+i)^t]（含 t=0 的初始投资）。"
            ],
            [
              "判断",
              "NPV>0表明按既定折现率方案具财务吸引力；多方案须同口径比较。"
            ],
            [
              "易错",
              "不要把不同年份的资金直接相加当净现值。"
            ]
          ]
        }
      ],
      "tip": "逐年现金流→按期数折现→合计，初始投入按负值处理。"
    },
    "21.1.5": {
      "page": 14,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "讲义采用达产年利润与项目总投资的比值来讨论收益率。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "投资收益率",
              "达产年利润 / 总投资。"
            ],
            [
              "判别",
              "与同口径的基准收益率比较。"
            ],
            [
              "注意",
              "讲义提示属于静态评价，计算时不逐年折现。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.1.6": {
      "page": 22,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "静态回收期直接累计净现金流；动态回收期先折现再累计。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "静态",
              "找到累计现金流由负转正的年份，必要时在该年内插。"
            ],
            [
              "动态",
              "把每期现金流折现后累计，通常较静态回收期更长。"
            ],
            [
              "常用插值",
              "（N−1）＋|上年末累计未回收额|/当年回收现金流。"
            ]
          ]
        }
      ],
      "tip": "动态回收期要先折现，静态回收期不考虑时间价值。"
    },
    "21.1.7": {
      "page": 20,
      "sourceDocument": "第21章计算-1 工程经济学",
      "lead": "多个能够满足相同要求的备选方案可以比较各项成本的折现总和。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "现值",
              "把未来各年费用折回决策时点。"
            ],
            [
              "选择",
              "在功能要求可比的前提下，费用现值较小的方案更经济。"
            ],
            [
              "辨析",
              "费用现值不是净现值；一个比费用，一个比净现金流。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.1": {
      "page": 2,
      "sourceDocument": "第21章计算-2 线性规划",
      "lead": "线性规划是在资源约束和非负条件下，对目标函数寻找最优可行解。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "决策变量",
              "例如生产数量 x、y。"
            ],
            [
              "目标函数",
              "例如 max Z=5x+4y。"
            ],
            [
              "约束条件",
              "例如 x+y≤4、x+2y≤6、x≥0、y≥0。"
            ],
            [
              "求解",
              "二维问题通常枚举可行域顶点并比较目标值。"
            ]
          ]
        }
      ],
      "tip": "明确变量→列目标→列约束→找可行顶点→比较。"
    },
    "21.2.2": {
      "page": 3,
      "sourceDocument": "第21章计算-2 线性规划",
      "lead": "每条不等式约束一个半平面，交集构成可行域，最优解常出现在顶点。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "边界",
              "将不等式临时改成等式求交点。"
            ],
            [
              "可行域",
              "同时满足全部不等式且变量非负的区域。"
            ],
            [
              "例题",
              "max(5x+4y)，约束 x+y≤4、x+2y≤6，最佳点 (4,0)，值20。"
            ],
            [
              "注意",
              "整数生产件数问题还须检查整数可行解。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.3": {
      "page": 3,
      "sourceDocument": "第21章计算-3 伏格尔方法",
      "lead": "运输问题给出各供给点库存、各需求点需求、每条路线单位运费，求费用较低的调配。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "参数",
              "供给量、需求量、单位运费矩阵。"
            ],
            [
              "平衡",
              "供给总量不等于需求总量时，可按题目设虚拟供给或需求点。"
            ],
            [
              "目标",
              "最小化运输费用 Σ运输量×路线单位运费。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.4": {
      "page": 2,
      "sourceDocument": "第21章计算-3 伏格尔方法",
      "lead": "伏格尔法是一种常用的初始运输方案构造方法，每轮用罚数比较机会成本。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "计算罚数",
              "每行、每列的次小成本减最小成本。"
            ],
            [
              "找最大罚数",
              "优先选择罚数最大的行或列。"
            ],
            [
              "分配",
              "在其最小成本格分配 min(余供给、余需求)。"
            ],
            [
              "继续",
              "划掉完成的行或列，重新算罚数直到分配结束。"
            ]
          ]
        }
      ],
      "tip": "算差→找最大→低成本分配→划掉→重算；VAM 不保证任意题都得到全局最优。"
    },
    "21.2.5": {
      "page": 7,
      "sourceDocument": "第21章计算-3 伏格尔方法",
      "lead": "讲义三仓四城示例的运输成本为 2900 元，本网站计算实验提供相同的矩阵。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "A 仓",
              "甲200，丁100，供应300。"
            ],
            [
              "B 仓",
              "甲200，丙300，供应500。"
            ],
            [
              "C 仓",
              "乙100，丁100，供应200。"
            ],
            [
              "运费合计",
              "200×3+100×6+200×1+300×2+100×4+100×5=2900。"
            ]
          ]
        }
      ],
      "tip": "示例结果 2900；一般 VAM 方案还可继续进行最优性检验。"
    },
    "21.2.6": {
      "page": 5,
      "sourceDocument": "第21章计算-4 匈牙利法",
      "lead": "指派问题强调人员与任务一一匹配，使总费用或总时间最小。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "输入",
              "n×n 成本矩阵，行列分别代表人员与任务。"
            ],
            [
              "约束",
              "每行每列只能选一个格子。"
            ],
            [
              "目标",
              "所选单元格成本之和最小。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.7": {
      "page": 5,
      "sourceDocument": "第21章计算-4 匈牙利法",
      "lead": "先按行、再按列减去相应最小值，让矩阵出现更多 0，再尝试构造独立零。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "行化简",
              "每行全体元素减去该行最小值。"
            ],
            [
              "列化简",
              "每列全体元素减去该列最小值。"
            ],
            [
              "独立零",
              "选出的 0 不能同时位于同一行或同一列。"
            ],
            [
              "复杂情形",
              "如不能凑足独立零，应继续覆盖零、调整矩阵，而非直接任选。"
            ]
          ]
        }
      ],
      "tip": "本站演示会展示行列减法；最终分配使用完整最优解枚举校验。"
    },
    "21.2.8": {
      "page": 8,
      "sourceDocument": "第21章计算-5 路径与资源分配",
      "lead": "最短路径是从指定起点到终点，使沿途边权总和最小的问题。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "图",
              "节点代表地点，箭头代表可通行方向，边权代表距离或费用。"
            ],
            [
              "方法",
              "非负权图可用逐点更新的最短路算法。"
            ],
            [
              "例题",
              "讲义图 V1→V2→V5→V6→V8，总距离为12。"
            ],
            [
              "警惕",
              "有向图不能反向走；题目若有负边，普通 Dijkstra 不适用。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.9": {
      "page": 14,
      "sourceDocument": "第21章计算-5 路径与资源分配",
      "lead": "最小生成树在全部节点可互通的条件下，使选中边的总权值最小。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "树",
              "所有节点连接、没有环。"
            ],
            [
              "破圈法",
              "每轮删除回路中的一条最大权边，直到无环。"
            ],
            [
              "避圈法",
              "从短边开始，若会成环则跳过。"
            ],
            [
              "区分",
              "最短路径是两点间优化，最小生成树是全网连接优化。"
            ]
          ]
        }
      ],
      "tip": "最短路找一条路线；生成树覆盖所有点。"
    },
    "21.2.10": {
      "page": 10,
      "sourceDocument": "第21章计算-5 路径与资源分配",
      "lead": "在预算总额约束下，按分配给各项目的投资额和收益表选择收益最大方案。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "状态",
              "已经分配的资源总量。"
            ],
            [
              "决策",
              "本阶段向当前项目分配多少资源。"
            ],
            [
              "递推",
              "当前收益加剩余资源可取得的最大收益。"
            ],
            [
              "终点",
              "所有项目分配完且不超预算。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.11": {
      "page": 2,
      "sourceDocument": "第21章计算-6 博弈与决策",
      "lead": "零和博弈矩阵的数值代表甲方收益，甲方保底、乙方止损。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "甲（行）",
              "每行取最小，最后从行最小值中取最大，即 maximin。"
            ],
            [
              "乙（列）",
              "每列取最大，最后从列最大值中取最小，即 minimax。"
            ],
            [
              "鞍点",
              "两值相等且对应的格子是双方纯策略均衡。"
            ]
          ]
        }
      ],
      "tip": "甲：小中取大；乙：大中取小。"
    },
    "21.2.12": {
      "page": 7,
      "sourceDocument": "第21章计算-6 博弈与决策",
      "lead": "若 maximin 与 minimax 不相等，不能仅靠选一个最值认定纯策略鞍点。",
      "blocks": [
        {
          "title": "知识结构 · 考点理解",
          "type": "concept",
          "items": [
            [
              "判别",
              "比较行最小的最大值与列最大的最小值。"
            ],
            [
              "相等",
              "存在纯策略鞍点，至少一个相应策略组合。"
            ],
            [
              "不等",
              "说明本矩阵没有纯策略鞍点，需要进一步分析。"
            ]
          ]
        }
      ],
      "tip": "结合定义、适用情境与讲义页码记忆。"
    },
    "21.2.13": {
      "page": 8,
      "sourceDocument": "第21章计算-6 博弈与决策",
      "lead": "双矩阵非零和博弈每个格子同时写甲、乙的收益，双方分别查找自身最佳反应。",
      "blocks": [
        {
